{
  "name": "asocial2-bun",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "serverl": "export PORT=8091 ;  bun run --inspect-wait=localhost:4000/ src/server.ts",
    "server": "set PORT=8091 && bun run --inspect-wait=localhost:4000/ src/server.ts",
    "schemaSqlite": "bun run --inspect-wait=localhost:4000/ src/fw/tools.ts genSchema --dbType sqlite",
    "ok": "bun run --inspect-wait=localhost:4000/ src/index.ts",
    "wptest": "bun run --inspect-wait=localhost:4000/ src/fw/tools.ts wptest"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "winston": "^3.19.0"
  }
}
